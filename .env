# -------- jwt配置 --------
# 秘钥
JWT_SECRET_KEY=here_is_the_secret_key_for_jwt_token
# 算法
JWT_ALGORITHM=HS256
# 过期时间(单位:分钟)
ACCESS_TOKEN_EXPIRE_MINUTES=120
# 签发人
JWT_ISS=issuer_id
# 不校验JWT token的路由
JWT_NO_CHECK_URIS=/login,/favicon.ico
# 刷新时间（单位：天）
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------- 图片配置 ----------
# 图片最大内存（单位：字节）
MAX_IMAGE_SIZE=20971520
# 图片存储路径
IMAGE_DIR=upload/images
# 服务器根路径
BASE_DIR=E:/设备维修辅助系统/app

# --------- 消息图片配置 ----------
# 图片最大内存（单位：字节）
MESSAGE_MAX_IMAGE_SIZE=20971520
# 图片存储路径
MESSAGE_IMAGE_DIR=upload/ask
# 服务器根路径
MESSAGE_BASE_DIR=E:/设备维修辅助系统/app
# 消息上下文最大token数量
MESSAGE_MAX_TOKEN=8000

# ---------- AI服务器配置 ----------
# AI问答api
AI_API=http://192.168.246.200:11434/api/chat
# AI模型
MODEL=qwen3-vl:8b-instruct
# 模型IP
SERVER_IP=192.168.246.200
# openai的api
API_KEY=EMPTY
# 模型根路由
MODEL_AI=/models/Qwen3-VL-8B-Instruct
# 最大token数
MAX_TOKEN=2000
# 输入最大token数
INPUT_TOKEN=8000

# ---------- embedding模型配置 ----------
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_MODEL_LOCAL_PATH=E:/设备维修辅助系统/app/embedding-model
MODEL_NAME=E:/设备维修辅助系统/app/bge/bge-m3
MODEL_WEIGHT=E:/设备维修辅助系统/app/bge/Visualized_m3.pth
MODEL_DOWNLOAD_URL=E:/设备维修辅助系统/app/bge/model

# ---------- milvus向量数据库配置 ----------
MILVUS_HOST=localhost
MILVUS_PORT=19530

# ---------- RAG参数设置 ----------
TOP_K=10
CHUNK_SIZE=300
OVERLAP=30
BATCH_SIZE=10
SIMILARITY_LOWER_LIMIT=0.65
SUMMARY_MAX_TOKEN=2000
TOP_K_DOCUMENTS=3

# ---------- 文档设置 ----------
DOCUMENT_BASE_DIR=E:/设备维修辅助系统/app
DOCUMENT_DIR=upload/documents

# ---------- 重排序模型 -----------
RERANK_MODEL=BAAI/bge-reranker-base

# ---------- Unified AI OpenAI-Compatible Endpoint ----------
AI_BASE_URL=http://192.168.246.200:8000/v1
AI_BASE_URL_ALT=http://192.168.246.200:8000/v1
# Optional fallback when AI_BASE_URL / AI_BASE_URL_ALT is not set
AI_PORT=8000
AI_PORT_ALT=8001

