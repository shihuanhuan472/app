# -------- jwt配置 --------
# 秘钥
JWT_SECRET_KEY=here_is_the_secret_key_for_jwt_token
# 算法
JWT_ALGORITHM=HS256
# 过期时间(单位:分钟)
ACCESS_TOKEN_EXPIRE_MINUTES=120
# 签发人
JWT_ISS=issuer_id
# 不校验JWT token的路由
JWT_NO_CHECK_URIS=/login,/favicon.ico
# 刷新时间（单位：天）
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------- 图片配置 ----------
# 图片最大内存（单位：字节）
MAX_IMAGE_SIZE=20971520
# 图片存储路径
IMAGE_DIR=upload/images
# 服务器根路径
BASE_DIR=D:/Pycharm/code/Maintenance_Assistance_System

# --------- 消息图片配置 ----------
# 图片最大内存（单位：字节）
MESSAGE_MAX_IMAGE_SIZE=20971520
# 图片存储路径
MESSAGE_IMAGE_DIR=upload/ask
# 服务器根路径
MESSSAGE_BASE_DIR=D:/Pycharm/code/Maintenance_Assistance_System

# ---------- AI服务器配置 ----------
# AI问答api
AI_API=http://192.168.246.200:11434/api/chat
# AI模型
MODEL=qwen3-vl:8b-instruct