# -------- jwt配置 --------
# 秘钥
JWT_SECRET_KEY=here_is_the_secret_key_for_jwt_token
# 算法
JWT_ALGORITHM=HS256
# 过期时间(单位:分钟)
ACCESS_TOKEN_EXPIRE_MINUTES=120
# 签发人
JWT_ISS=issuer_id
# 不校验JWT token的路由
JWT_NO_CHECK_URIS=/login,/favicon.ico
# 刷新时间（单位：天）
REFRESH_TOKEN_EXPIRE_DAYS=7

# -------- 外部系统 API Key 认证配置 --------
# 外部系统可使用 Header: Authorization: Bearer <SYSTEM_API_KEY> 调用受保护接口
SYSTEM_API_KEYS=mas_qlMaGy3bajobnZd3f3U-z63_WBpJPFChSc7pOvBo0Rc
# API Key 通过后映射到的系统用户 ID，用于复用现有角色和权限体系
SYSTEM_API_KEY_USER_ID=1

# ---------- 图片配置 ----------
# 图片最大内存（单位：字节）
MAX_IMAGE_SIZE=20971520
# 图片存储路径
IMAGE_DIR=upload/images
# 服务器根路径
BASE_DIR=D:/web/app/Maintenance_Assistance_System

# --------- 消息图片配置 ----------
# 图片最大内存（单位：字节）
MESSAGE_MAX_IMAGE_SIZE=20971520
# 图片存储路径
MESSAGE_IMAGE_DIR=upload/ask
# 服务器根路径
MESSAGE_BASE_DIR=D:/web/app/Maintenance_Assistance_System
# 消息上下文最大token数量
MODEL_CONTEXT_WINDOW=131072
# Hard model context-window limit (vLLM --max-model-len); input + output + margin must fit.
CHAT_MAX_INPUT_TOKENS=120000
# Chat/RAG input budget: prompt, history, retrieved documents and images.
CHAT_MAX_OUTPUT_TOKENS=8192
# Chat/RAG maximum generated answer length.
CHAT_CONTEXT_MARGIN_TOKENS=2048
# Chat/RAG safety margin for prompts and token-estimation error.
DOCUMENT_MAX_INPUT_TOKENS=64512
# Document parsing input budget; preserves source text for classification/extraction.
DOCUMENT_MAX_OUTPUT_TOKENS=64512
# Document parsing maximum generated classification/extraction result.
DOCUMENT_CONTEXT_MARGIN_TOKENS=2048
# Document parsing safety margin.
IMAGE_MAX_INPUT_TOKENS=24576
# Image understanding input budget.
IMAGE_MAX_OUTPUT_TOKENS=4096
# Image understanding maximum generated description/result.
IMAGE_CONTEXT_MARGIN_TOKENS=1024
# Image understanding safety margin.
IMAGE_INPUT_TOKENS=1500
# Estimated token cost charged for each image in a prompt.

# ---------- AI服务器配置 ----------
# openai的api
#API_KEY=sk-ws-H.RPIDLHY.Vrw9.MEYCIQCUTqINXVG-jBzs9uLw_jIU_pbBpZntagAJJPEa8N9qdAIhAIHBeV7nWkuH0C9YWf0vYrr39R9B7N3aU9rDL6Dl_w6m
API_KEY=mgi-123456
# 模型根路由
MODEL_AI=/data/models/Qwen3.8-27B
# 超长层级图片解析：按重叠分带发送给视觉模型，并保存节点裁剪图/坐标。
ENABLE_HIERARCHICAL_IMAGE_PARSER=1
HIERARCHICAL_IMAGE_MIN_ASPECT_RATIO=3.0
HIERARCHICAL_IMAGE_MIN_HEIGHT=1800
HIERARCHICAL_IMAGE_TILE_HEIGHT=640
HIERARCHICAL_IMAGE_TILE_OVERLAP=192
HIERARCHICAL_IMAGE_MIN_TILE_WIDTH=1600
HIERARCHICAL_IMAGE_MAX_OUTPUT_TOKEN=6000
HIERARCHICAL_IMAGE_MAX_NODES_PER_TILE=40
HIERARCHICAL_IMAGE_ALLOW_PLACEHOLDER_FALLBACK=0
HIERARCHICAL_IMAGE_REVIEW_THRESHOLD=0.72
HIERARCHICAL_IMAGE_CONNECTOR_THRESHOLD=0.12
HIERARCHICAL_IMAGE_CROP_PADDING=24
#MODEL_AI=qwen-vl-max
# 最大token数
# 输入最大token数
AI_BASE_URL=https://iBrain.mgi-tech.com/API-Qwen
AI_BASE_URL_ALT=https://iBrain.mgi-tech.com/API-Qwen
#AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#AI_BASE_URL_ALT=https://dashscope.aliyuncs.com/compatible-mode/v1
# ---------- embedding模型配置 ----------
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_MODEL_LOCAL_PATH=D:/web/app/Maintenance_Assistance_System/embedding-model
MODEL_NAME=BAAI/bge-m3
MODEL_WEIGHT=D:/web/app/Maintenance_Assistance_System/bge/Visualized_m3.pth
MODEL_DOWNLOAD_URL=D:/web/app/Maintenance_Assistance_System/bge/model

# ---------- MinerU配置 ----------
MODELSCOPE_CACHE=D:/web/app/Maintenance_Assistance_System/minerU/modelscope
MINERU_TOOLS_CONFIG_JSON=D:/web/app/Maintenance_Assistance_System/minerU/mineru.json
MINERU_MODEL_SOURCE=modelscope
MINERU_ENABLED=1
MINERU_BACKEND=pipeline
MINERU_METHOD=ocr
MINERU_LANG=ch
MINERU_FORMULA_ENABLE=false
MINERU_TABLE_ENABLE=true
MINERU_TEMP_DIR=D:/web/app/Maintenance_Assistance_System/runtime/mineru_tmp
MINERU_KEEP_OUTPUT=1
MINERU_OUTPUT_DIR=D:/web/app/Maintenance_Assistance_System/runtime/mineru_output
MINERU_TIMEOUT=1800

# ---------- PPT解析路由配置 ----------
# 图片型/混合型PPT启用“PPT转PDF后交给MinerU”的路线；找不到soffice时自动退回原生PPT解析。
PPT_TO_PDF_ENABLED=1
# 服务器如未把LibreOffice加入PATH，可显式配置，例如 /usr/bin/soffice 或 C:/Program Files/LibreOffice/program/soffice.exe
PPT_SOFFICE_EXE=D:/web/xxxx/program/soffice.exe
PPT_KEEP_CONVERTED_PDF=0

# ---------- milvus向量数据库配置 ----------
MILVUS_HOST=localhost
MILVUS_PORT=19530

# ---------- RAG参数设置 ----------
TOP_K=50
CHUNK_SIZE=300
OVERLAP=30
BATCH_SIZE=10
SIMILARITY_LOWER_LIMIT=0.60
DOMAIN_TERM_MISSING_PENALTY=0.10
TOP_K_DOCUMENTS=3

# ---------- 文档设置 ----------
DOCUMENT_BASE_DIR=D:/web/app/Maintenance_Assistance_System
DOCUMENT_DIR=upload/documents

# ---------- 重排序模型 -----------
RERANK_MODEL=BAAI/bge-reranker-base

SEARCH_INDEX_TEXT_ANALYZER=standard
SEARCH_INDEX_REQUIRED=false

# ---------- 外部用户同步 ----------
# 联调前改为 true，并配置对方提供的地址和令牌
EXTERNAL_USER_SYNC_ENABLED=false
EXTERNAL_USER_SYNC_URL=https://dev.mgi-tech.com/labvision/api/users/sync
EXTERNAL_USER_SYNC_TOKEN=
EXTERNAL_USER_SYNC_TIMEOUT=10
EXTERNAL_USER_SYNC_RETRY_DELAYS=5,30,300

# ---------- 反馈功能 ----------
# 总开关：控制反馈入口、提交接口和反馈处理接口
FEEDBACK_ENABLED=true
# 学习开关：控制反馈是否参与后续检索和回答
FEEDBACK_LEARNING_ENABLED=false


