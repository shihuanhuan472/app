MODEL_DOWNLOAD_URL=D:/web/app/Maintenance_Assistance_System/bge/model

# ---------- milvus向量数据库配置 ----------
MILVUS_HOST=localhost
MILVUS_PORT=19530

# ---------- RAG参数设置 ----------
TOP_K=50
CHUNK_SIZE=300
OVERLAP=30
BATCH_SIZE=10
SIMILARITY_LOWER_LIMIT=0.65
DOMAIN_TERM_MISSING_PENALTY=0.18
SUMMARY_MAX_TOKEN=2000
TOP_K_DOCUMENTS=3

# ---------- 文档设置 ----------
DOCUMENT_BASE_DIR=D:/web/app/Maintenance_Assistance_System
DOCUMENT_DIR=upload/documents

# ---------- 重排序模型 -----------
RERANK_MODEL=BAAI/bge-reranker-base

